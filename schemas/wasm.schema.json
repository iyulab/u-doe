    "ResponseSpecInput": {
      "additionalProperties": false,
      "description": "One response's desirability specification, as `desirability` and\n`optimize_desirability` read it. Declared for TypeScript so a misspelt\nfield or goal fails to compile rather than at the boundary.\n\nEach goal takes the limits and exponents its curve has: `Maximize`\n`lower`, `target`, `s1`; `Minimize` `target`, `upper`, `s1`; `Target` all\nfive. A field the goal does not read is refused (`invalid_option`), not\nignored -- it used to be required and then ignored.",
      "properties": {
        "goal": {
          "enum": [
            "Maximize",
            "Minimize",
            "Target"
          ],
          "type": "string"
        },
        "importance": {
          "default": 1.0,
          "description": "Relative importance weight rᵢ (Derringer-Suich). Optional; defaults to 1.0.",
          "format": "double",
          "type": "number"
        },
        "lower": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "s1": {
          "format": "double",
          "type": "number"
        },
        "s2": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "target": {
          "format": "double",
          "type": "number"
        },
        "upper": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "goal",
        "target",
        "s1"
      ],
      "type": "object"
    },
