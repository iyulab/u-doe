{
  "$schema": "scripts/engine-card/engine-card.schema.json",
  "card_version": 1,
  "engine": {
    "id": "u-doe",
    "summary": "Design of experiments: generates factorial, fractional factorial, screening, response-surface, Taguchi and mixture designs, analyses two-level experiments (effects, ANOVA, least squares with Type III sums of squares), fits and explores second-order response surfaces, scores multiple responses by desirability and computes the power of a factorial test.",
    "version": "0.25.0",
    "license": "MIT",
    "repository": "https://github.com/iyulab/u-doe"
  },
  "surfaces": [
    {
      "kind": "crate",
      "name": "u-doe",
      "package_version": "0.25.0",
      "engine_version": "0.25.0",
      "error_shape": "Err(DoeError), whose variant names the reason and holds the values behind it."
    },
    {
      "kind": "npm",
      "name": "@iyulab/u-doe",
      "package_version": "0.25.0",
      "engine_version": "0.25.0",
      "wasm": true,
      "note": "Native JS values in and out, typed in the .d.ts; an absent value in a result is null. Bundler and Node targets; no bundler-less browser build.",
      "error_shape": "A thrown Error whose code property is the code, with the fields (parameter, index, min, max, got, expected, ...) as its other properties."
    }
  ],
  "errors": {
    "shape": "A refusal carries a stable snake_case 'code' and the fields listed for that code.",
    "source": {
      "catalog": "code_catalog in src/wasm.rs, read off the crate's DoeError variants and the binding's own reasons; published as codes() in WebAssembly. What each code means is tabled in README.md, which a test holds equal to the catalog.",
      "test": "src/wasm.rs::code_catalog_tests::the_readme_documents_every_code_and_no_other"
    }
  },
